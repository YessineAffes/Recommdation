# Provider principal: anthropic | ollama | openai_compat
LLM_PROVIDER=ollama

# Modèles par role
LLM_NLU_MODEL=mistral:7b
LLM_FORMAT_MODEL=mistral:7b

# Ollama / OpenAI-compatible
OLLAMA_BASE_URL=http://localhost:11434/v1
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama

# Anthropic (utilisé uniquement si LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-...
